# Copy this file to .env for local testing only.
# On Render, you'll set these as real Environment Variables in the dashboard instead
# (see README.md) — you do NOT upload a .env file to Render.

# Connection string from Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Optional. If not set, the app generates and stores one automatically.
PORT=4000
